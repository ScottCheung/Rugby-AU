{
  "name": "rugby-site-manager",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:ui": "npm run build -w @scottcheung/ui",
    "dev": "npm run build:ui && npm run dev -w @rugby/web",
    "build": "npm run build:ui && npm run build -w @rugby/web",
    "start": "npm run start -w @rugby/web",
    "seed": "npm run seed -w @rugby/web",
    "migrate": "npm run migrate -w @rugby/web",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run build:ui && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
