  "entries": [
    {
      "collection": "news",
      "slug": "choosing-a-club",
      "data": {
        "category": "Community",
        "date": "2026-11-18",
        "headline": "How to choose a rugby club",
        "standfirst": "Close to home, the right teams, a welcoming feel: what to look for.",
        "image": {
          "url": "https://images.unsplash.com/photo-1752681304960-bd4e018a04bb?auto=format&fit=crop&w=1600&q=80",
          "alt": "A team in light blue and white in a huddle"
        },
        "body": [
          {
            "kind": "paragraph",
            "text": "There are clubs across Victoria for every age and level. The right one is usually the closest, but it is worth a look around."
          },
          {
            "kind": "heading",
            "text": "Check the teams"
          },
          {
            "kind": "paragraph",
            "text": "Make sure the club has a team for you: juniors by age group, senior grades, women’s fifteens and sevens, or veterans."
          },
          {
            "kind": "heading",
            "text": "Visit a training night"
          },
          {
            "kind": "paragraph",
            "text": "Most clubs are happy for you to try a session before you register. You can meet the coaches and see how the club feels."
          },
          {
            "kind": "heading",
            "text": "Register"
          },
          {
            "kind": "paragraph",
            "text": "Once you have chosen, registration is done online, and the club will tell you when and where to turn up."
          }
        ]
      }
    },
    {
      "collection": "news",
      "slug": "becoming-a-referee",
      "data": {
        "category": "Community",
        "date": "2026-11-11",
        "headline": "Thinking about refereeing? Here’s how to start",
        "standfirst": "Referees are needed every weekend, and you don’t need to have played.",
        "image": {
          "url": "https://images.unsplash.com/photo-1485426337939-af69cf101909?auto=format&fit=crop&w=1600&q=80",
          "alt": "Five players chasing play during a match"
        },
        "body": [
          {
            "kind": "paragraph",
            "text": "Every game needs a referee, and clubs are always looking for more. Many referees start in their teens, others after their playing days."
          },
          {
            "kind": "heading",
            "text": "Training"
          },
          {
            "kind": "paragraph",
            "text": "An introductory course covers the laws, positioning and managing a game. New referees usually start with junior matches."
          },
          {
            "kind": "heading",
            "text": "Support"
          },
          {
            "kind": "paragraph",
            "text": "A mentor watches your first games and helps you improve. As you gain experience you can move up to senior and representative rugby."
          }
        ]
      }
    },
    {
      "collection": "news",
      "slug": "junior-rugby-explained",
      "data": {
        "category": "Pathways",
        "date": "2026-11-04",
        "headline": "Junior rugby explained",
        "standfirst": "Age groups, rules and what changes as players grow.",
        "image": {
          "url": "https://images.unsplash.com/photo-1729871337531-249297613423?auto=format&fit=crop&w=1600&q=80",
          "alt": "A young player in red and white sprinting with the ball"
        },
        "body": [
          {
            "kind": "paragraph",
            "text": "Junior rugby is organised by age, and the rules change as players grow so the game stays safe and fun."
          },
          {
            "kind": "heading",
            "text": "The youngest players"
          },
          {
            "kind": "paragraph",
            "text": "The youngest age groups play non-contact games that teach passing, running and teamwork."
          },
          {
            "kind": "heading",
            "text": "Moving to tackle rugby"
          },
          {
            "kind": "paragraph",
            "text": "Tackling is introduced gradually, often on smaller fields with fewer players, before juniors move to the full game."
          },
          {
            "kind": "heading",
            "text": "Teenagers"
          },
          {
            "kind": "paragraph",
            "text": "Older juniors play full rugby, with age and size rules to keep matches fair. The best are picked for representative teams."
          }
        ]
      }
    }
  ]
